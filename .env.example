# Copy to .env. KEY=VALUE lines, # for comments. Anything already in the
# environment wins over this file, and a command line option wins over both.

# --- build-fpkg.sh options -------------------------------------------------
#MODE=app-merge                 # app-merge | remaster | separate
#BACKPORT=1                     # 0 is --no-backport
#BACKPORT_TARGET_SDK=auto       # or an explicit stamp, e.g. 0x08500001
#KEYSTONE_MODE=retail           # retail | kscreate
#OUT_DIR=/mnt/user/cache/out
#UPDATE=                        # a path, or "none" for --no-update
#DLC_MODE=                      # "none" for --no-dlc
#DLC="dirA dirB"                # repeating --dlc; paths cannot contain spaces
#CONTENT_ID=
#PS2_TID=
#BASE_PKG_IN=

# pub tools stages the internal image here
#IMG_TMP_DIR=/mnt/cache/fpkger/tmp

# sce_sys a backport patch carries. A directory is taken whole.
#PATCH_SCE_SYS=param.sfo icon0.png playgo-chunk.dat npbind.dat

# --- progress and debugging ------------------------------------------------
#PROGRESS_EVERY=15              # seconds between progress lines; 0 disables
#NO_PROGRESS=                   # any value silences the watcher
#KEEP_STAGE=                    # any value keeps the patch stage after a build
#KEEP_VERSION_RECORDS=          # any value leaves PT_SCE_VERSION alone
#WINEDEBUG=-all

# --- tool locations --------------------------------------------------------
#SDK_DIR=/opt/fpkger/PS4_Fake_PKG_Tools_3
#ORBIS_PUB_CMD=
#GENGP4_APP=
#GENGP4_PATCH=
#SFO_TOOL=
#MAKE_FSELF=
#BACKPORT_SDK=
#PKG_SET_APPVER=

# --- dumping (pfsdump.py; also the web UI's prefill) ---------------------------
#HOST=192.168.1.208:2121        # the console address
#DUMP_DIR=/mnt/user/cache/dumps # where dumps go; the Build tab scans here too
#PKG_DIR=                       # where packages go; defaults to OUT_DIR above

# --- web UI (web/server.py) --------------------------------------------------
#WEB_PORT=8080
#WEB_BIND=0.0.0.0
#WEB_ROOTS=/work:/ps4dumps      # the only folders the UI may browse or write
#WEB_PASSWORD=                  # HTTP basic auth; strongly advised off-LAN
#WEB_LOG_DIR=                   # default <first root>/fpkger-logs
#SCAN_DIR=                      # Build tab scans here for dumps; default DUMP_DIR
#SCAN_DEPTH=3                   # folders below SCAN_DIR the scan descends
#BUILD_FPKG=                    # tool overrides; default is beside server.py
#BUILD_PS5=
#LIBPROSPERO_TEMP_DIR=          # build-ps5 scratch
#PS5BACKPORT_LIBS=              # Backport tab: 13.60 firmware dump root; must be under WEB_ROOTS
#BACKPORT_DATA_DIR=             # backport binary cache; default <first root>/ps5backport-data
